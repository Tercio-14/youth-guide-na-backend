# ============================================================
# YouthGuide NA Backend - Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK
# Path to your Firebase service account JSON file.
# Download from Firebase Console > Project Settings > Service Accounts.
FIREBASE_SERVICE_ACCOUNT_PATH=./youth-guide-na-service-account.json

# Google Gemini AI
# Obtain your API key from https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Chat configuration
CHAT_TEMPERATURE=0.2
CHAT_MAX_TOKENS=600
MAX_OPPORTUNITIES_PER_QUERY=5
USE_CHAT_CONTEXT=false
CHAT_CONTEXT_TURNS=3

# Retrieval configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATES=100

# Admin access
# Comma-separated list of email addresses that are granted admin access
# as a fallback when the Firebase custom claim has not yet been set.
ADMIN_EMAILS=

# Python scraper
# Set to 'python' on Windows if 'python3' is not in PATH.
PYTHON_CMD=python3

# Testing only - NEVER enable in production
DISABLE_AUTH_FOR_TESTING=false

# Logging
LOG_LEVEL=info

# ============================================================
# Staging / Production changes
# ============================================================
# NODE_ENV=production
# PORT=<assigned by hosting provider>
# FRONTEND_URL=https://your-production-frontend.com
# LOG_LEVEL=warn
# DISABLE_AUTH_FOR_TESTING=false  (must be false in production)
